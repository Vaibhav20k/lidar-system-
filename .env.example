# Optional local sync API. The native app works offline without it.
# Set an HTTPS URL when building a native app that uses sync.
VITE_API_URL=
# Server: required for LAN exposure; clients enter this token in Settings.
ROOMFORM_API_TOKEN=
ROOMFORM_HOST=127.0.0.1
ROOMFORM_PORT=8787
ROOMFORM_DATA_DIR=.data
ROOMFORM_ALLOWED_ORIGINS=
